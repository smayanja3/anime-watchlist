<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>AniManager/Register</title>
</head>

<body>
    <header>
        <h2>Ani<span>Manager</span></h2>
        <nav>
            <!-- <ul>
                <li>Sign Up</li>
                <li>Register</li>
            </ul> -->
        </nav>
    </header>
    <div>
        <h1>Welcome to AniManager</h1>
        <p>Create an account to start tracking what you watch</p>
        <form action="/signup" method="POST">
            <label>Username
                <input type="text" name="username" placeholder="sakura_fan">
            </label>
            <label>Email
                <input type="text" name="email" placeholder="sakura@example.com">
            </label>
            <!-- have to make password type password so its not viable -->
            <label>Password
                <input type="password" name="password" placeholder="*************">
            </label>
            <button type="submit">Register</button>
        </form>
        <p>Already have an account?<a href="/login"> Sign in</a></p>

</body>

</html>