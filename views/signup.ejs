<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>AniManager/Register</title>
</head>
<body>
    <header>
        <h2>Ani<span>Manager</span></h2>
        <nav>
            <ul>
                <li>Sign Up</li>
                <li>Register</li>
            </ul>
        </nav>
    </header>
    <div>
        <h1>Welcome to AniManager</h1>
        <p>Create an account to start tracking what you watch</p>
        <span>
            <input type="text" placeholder="sakura_fan">
        </span>
        <span>
            <input type="text" placeholder="sakura@example.com">
        </span>
        <span>
            <input type="text" placeholder="*************">
        </span>
        <buton type="submit">Register</buton>
        <div>Already have an account? <a href="">Sign in</a></div>
    </div>
    
</body>
</html>