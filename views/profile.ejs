<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/profile.css">
    <title><%= user.username %>'s Profile</title>
</head>
<body>
    <header>
        <h2 class="logo">Ani<span>Manager</span></h2>
        <nav> 
            <ul>
                <li><a href="/profile"> Profile</a></li>
                <li><a href="/watchlist"> Watchlist</a></li>
                <li><a href="/logout"> Sign Out</a></li>
            </ul>
        </nav>
    </header>
<main>
    <!-- profile == MY watchlist, only the shows i added -->
    <h1 class="profileName"><%= user.username %></h1>

   <!-- .action == puts the buttons in a row with a gap (lives in style.css) -->
   <div class="action">
       <a href="/watchlist/new" class="btn">+ Add to watchlist</a>
       <a href="/watchlist" class="btnGhost">See everyone's watchlist</a>
   </div>

   <!-- watching.length == how many shows i added -->
   <h2 class="section">My Watchlist · <%= watching.length %></h2>

   <% if (watching.length === 0) { %>
    <p>You haven't added anything yet.</p>
   <% } %>

   <section class="cardList">
   <% watching.forEach((anime) => { %>
    <!-- same card as the global feed (views/partials/card.ejs) -->
    <!-- showStatus true == these are MY shows so the stamp is MY status -->
    <%- include('partials/card', { anime, currentUser, showStatus: true }) %>
   <% }) %>
   </section>
</main>
</body>
</html>