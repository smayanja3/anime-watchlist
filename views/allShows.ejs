<!DOCTYPE html>
<html lang="en"> 

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&family=Zen+Maru+Gothic:wght@700&display=swap">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/watchlist.css">
    <title>Full Watchlist</title>
</head>
 
<body>
    <header>
         <h2 class="logo">Ani<span>Manager</span></h2>
        <nav>
            <ul>
                <li><a href="/profile"> Profile</a></li>
                <li><a href="/watchlist"> Watchlist</a></li>
                <li><a href="/logout"> Sign Out</a></li>
            </ul>
        </nav>
    </header>
<main>
    <div class="pageTop">
    <h1>My Watchlist</h1>
    <a href="/watchlist/new" class="btn">+ ADD</a>
    </div>

<section class="cardList">
<% if (animes.length === 0) { %>
    <p> Nothing here yet. <a href="/watchlist/new">Add a show</a>.</p>
<% } %>

<% animes.forEach((anime) => { %>
    <a href="/watchlist/<%= anime._id %>" class="card">
        <div>
        <p class="title"><%= anime.title %></p>
        <p class="details">
            <!-- print the type: = Series Movie, OVA -->
            <%= anime.type %>

            <!-- print season if it has one / some are movies  -->
            <% if (anime.season) { %>
              · Season <%= anime.season %>  
           <% } %>    

            <!-- print epsides like 123/148 or ? if nothing entered --> 
             · Ep <%= anime.episodesWatched %> / <%= anime.totalEpisodes || '?' %>

            <!-- print status of show -->
                · <%= anime.status %>
             <!-- print the rating *10 -->
              <% if (anime.rating) { %>
                · Rating <%= anime.rating %>
             <% } %>
        </p>
    </div>
    <span class="status <%= anime.status %>"><%= anime.status %></span>
</a>
      <%  }) %>
</section>
</main>

</body>

</html>