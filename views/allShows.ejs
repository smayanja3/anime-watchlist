<!DOCTYPE html>
<html lang="en"> 

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- fonts link was here, style.css loads them for every page now -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/watchlist.css">
    <title>Full Watchlist</title>
</head>
 
<body>
    <header>
         <h2 class="logo">Ani<span>Manager</span></h2>
        <nav>
            <ul>
                <li><a href="/profile"> Profile</a></li>
                <li><a href="/watchlist"> Watchlist</a></li>
                <li><a href="/logout"> Sign Out</a></li>
            </ul>
        </nav>
    </header>
<main>
    <div class="pageTop">
        <div>
            <!-- this page == the GLOBAL feed, everything everyone added -->
            <h1>Watchlist</h1>
            <p class="subtitle">What everyone is watching</p>
        </div>
        <a href="/watchlist/new" class="btn">+ ADD</a>
    </div>

<% if (animes.length === 0) { %>
    <p> Nothing here yet. <a href="/watchlist/new">Add a show</a>.</p>
<% } %>

<section class="cardList">
<% animes.forEach((anime) => { %>
    <!-- the card lives in views/partials/card.ejs now (shared with profile) -->
    <!-- showStatus false == no watching/hold stamp here, thats only true for whoever added it -->
    <%- include('partials/card', { anime, currentUser, showStatus: false }) %>
<% }) %>
</section>
</main>

</body>

</html>